<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.senai.crudjavafx.controller.ProdutosController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <Label style="-fx-font-weight: bold;" text="Gerenciamento de Produtos"><font><Font name="Bodoni MT Black" size="28.0" /></font></Label>

    <HBox alignment="CENTER" spacing="10">
        <TextField fx:id="txtNome" promptText="Nome do Produto" />
        <TextField fx:id="txtPreco" promptText="Preço" />
        <Button onAction="#salvarProduto" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Salvar">
         <font>
            <Font name="Bauhaus 93" size="12.0" />
         </font></Button>
        <Button onAction="#excluirProduto" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Excluir">
         <font>
            <Font name="Bauhaus 93" size="12.0" />
         </font></Button>
        <Button onAction="#limparCampos" text="Limpar">
         <font>
            <Font name="Bauhaus 93" size="12.0" />
         </font></Button>
    </HBox>

    <TableView fx:id="tabelaProdutos" onMouseClicked="#selecionarItem" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="63.0" text="ID" />
            <TableColumn fx:id="colNome" prefWidth="248.0" text="Nome" />
            <TableColumn fx:id="colPreco" prefWidth="179.0" text="Preço (R$)" />
        </columns>
    </TableView>
</VBox>
