<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senai.crudjavafx.controller.VendasController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <VBox alignment="CENTER" prefHeight="68.0" style="-fx-background-color: GREEN;">
        <children>
            <Label text="Nova Venda" textFill="WHITE">
                <font><Font name="Bodoni MT Black" size="28.0" /></font>
            </Label>
        </children>
        <VBox.margin>
            <Insets left="-20.0" right="-20.0" top="-20.0" />
        </VBox.margin>
    </VBox>

    <HBox alignment="CENTER" spacing="15">
        <VBox spacing="5">
            <Label style="-fx-font-weight: bold;" text="Cliente:" />
            <ComboBox fx:id="cbCliente" prefWidth="200.0" promptText="Selecione o Cliente" />
        </VBox>
        <VBox spacing="5">
            <Label style="-fx-font-weight: bold;" text="Produto:" />
            <ComboBox fx:id="cbProduto" prefWidth="200.0" promptText="Selecione o Produto" />
        </VBox>
        <VBox spacing="5">
            <Label style="-fx-font-weight: bold;" text="Qtd:" />
            <Spinner fx:id="spQuantidade" prefWidth="80.0" />
        </VBox>
    </HBox>

    <HBox alignment="CENTER" spacing="15">
        <TextField fx:id="txtValorUnitario" editable="false" prefWidth="120.0" promptText="Valor Unitário" />
        <TextField fx:id="txtValorTotal" editable="false" prefWidth="120.0" promptText="Valor Total" style="-fx-background-color: #f4f4f4; -fx-font-weight: bold;" />

        <Button onAction="#adicionarItem" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Adicionar">
            <font><Font name="Bauhaus 93" size="12.0" /></font>
        </Button>
        <Button onAction="#finalizarVenda" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Finalizar">
            <font><Font name="Bauhaus 93" size="12.0" /></font>
        </Button>
        <Button onAction="#limparCampos" text="Limpar">
            <font><Font name="Bauhaus 93" size="12.0" /></font>
        </Button>
      <Button onAction="#relatorioVendas" text="Relatorio">
         <font>
            <Font name="Bauhaus 93" size="12.0" />
         </font>
      </Button>
    </HBox>

    <TableView fx:id="tabelaVendas" onMouseClicked="#selecionarItem" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="78.0" text="id" />
         <TableColumn fx:id="colCliente1" prefWidth="190.0" text="Cliente" />
            <TableColumn fx:id="colProduto" prefWidth="209.0" text="Produto" />
            <TableColumn fx:id="colQtd" prefWidth="141.0" text="Quantidade" />
            <TableColumn fx:id="colValorU" prefWidth="142.0" text="V. Unitário" />
            <TableColumn fx:id="colValorT" prefWidth="150.0" text="Total" />
        </columns>
    </TableView>
</VBox>
